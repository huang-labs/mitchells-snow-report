{
  "name": "mitchells-snow-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "build": "next build",
    "start": "wrangler dev --local",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "npm run build && wrangler deploy --dry-run",
    "preview": "npm run build && wrangler dev --local",
    "preview:scheduled": "npm run build && wrangler dev --local --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "collect:once": "tsx scripts/collect-once.ts",
    "dailysnow:once": "tsx scripts/dailysnow-once.ts",
    "dailysnow:replay": "tsx scripts/dailysnow-replay.ts",
    "share:render": "tsx scripts/render-share-image.ts",
    "smoke": "tsx scripts/smoke-worker.ts",
    "preview:refresh": "tsx scripts/preview-dispatch.ts refresh",
    "preview:dailysnow": "tsx scripts/preview-dispatch.ts dailysnow"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "fast-png": "8.0.0",
    "harfbuzz-runtime": "npm:harfbuzzjs@0.10.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "fflate": "0.8.3",
    "@cf-wasm/satori": {
      "satori": "0.33.5"
    }
  }
}
