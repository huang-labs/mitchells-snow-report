{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mitchells-snow-report",
  // Direct Worker API and cron; static page requests bypass Worker code.
  "main": "./worker.ts",
  // Satori's font shaper needs a precompiled WASM module in workerd.
  "alias": { "harfbuzzjs": "./src/worker/harfbuzz.ts" },
  "define": { "__filename": "\"/worker.js\"", "__dirname": "\"/\"" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only on the custom domain (Cloudflare manages its DNS record and certificate).
  "routes": [{ "pattern": "mitchells-snow-report.huang.mx", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "mitchells-snow-report",
    // Contact appended to the collector's User-Agent (api.weather.gov asks clients to identify themselves).
    "COLLECTOR_CONTACT": "https://mitchells-snow-report.huang.mx"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/daily-snow/opengraph-image", "/daily-snow/*/opengraph-image"]
  },
  "kv_namespaces": [
    {
      "binding": "SNOW_KV",
      // Production namespace (account "Huang Inc."). Not a secret.
      "id": "5fb1857843374e8ea427c2117b5f3955"
    }
  ],
  // CollectorObject is the single writer of the source snapshot (src/worker/collector-object.ts).
  // PR previews carry the class and migration but no binding: they run no cron or admin collection.
  "durable_objects": {
    "bindings": [{ "name": "COLLECTOR", "class_name": "CollectorObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollectorObject"] }],
  // One global collection cron for every source category.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Each PR gets an isolated Worker Preview with these bindings.
  "previews": {
    "define": { "__filename":"\"/worker.js\"", "__dirname":"\"/\"" },
    "vars": { "AI_GATEWAY_ID":"mitchells-snow-report", "COLLECTOR_CONTACT":"https://mitchells-snow-report.huang.mx" },
    "kv_namespaces":[{"binding":"SNOW_KV","id":"f9e542e8a1d0405f8624beade1bba09b"}],
    "ai":{"binding":"AI"}
  },
  "env": {
    "preview": {
      "name":"mitchells-snow-report-preview",
      "define": { "__filename":"\"/worker.js\"", "__dirname":"\"/\"" },
      "routes":[], "workers_dev":false, "preview_urls":true,
      "vars": { "AI_GATEWAY_ID":"mitchells-snow-report", "COLLECTOR_CONTACT":"https://mitchells-snow-report.huang.mx" },
      "kv_namespaces":[{"binding":"SNOW_KV","id":"f9e542e8a1d0405f8624beade1bba09b"}],
      "ai":{"binding":"AI"},
      // No cron and no admin token, so nothing here calls CollectorObject.
      "durable_objects":{"bindings":[]},
      "triggers":{"crons":[]}
    }
  }

}
